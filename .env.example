# Copy to .env.local for `vercel dev`, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=iker@puresightwc.com
# Must be an address on a domain you've verified in Resend.
# Without it, Resend's test sender is used, which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=Puresight Website <website@puresightwc.com>
